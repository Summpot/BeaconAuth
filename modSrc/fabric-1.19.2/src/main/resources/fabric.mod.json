{
  "schemaVersion": 1,
  "id": "beaconauth",
  "version": "${version}",
  "name": "Beacon Auth",
  "description": "Secure web, OAuth, and passkey authentication for Minecraft servers using a BeaconAuth auth server.",
  "authors": ["Summpot"],
  "contact": {
    "homepage": "https://github.com/Summpot/BeaconAuth",
    "sources": "https://github.com/Summpot/BeaconAuth",
    "issues": "https://github.com/Summpot/BeaconAuth/issues"
  },
  "license": "MIT",
  "icon": "assets/beaconauth/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "io.github.summpot.beaconauth.fabric.BeaconAuthModFabric"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "io.github.summpot.beaconauth.fabric.client.BeaconAuthModFabricClient"
      }
    ]
  },
  "mixins": ["beaconauth.mixins.json"],
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "~1.19.2",
    "java": ">=17",
    "architectury": ">=6.6.92",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=1.13.7+kotlin.2.2.21"
  }
}
